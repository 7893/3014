{
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noDescendingSpecificity": "off",
				"noParameterAssign": "off",
				"useNodeAssertStrict": "off",
				"useNumberNamespace": "off",
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"noImportantStyles": "off",
				"noForEach": "off"
			},
			"suspicious": {
				"noShadowRestrictedNames": "off",
				"useIterableCallbackReturn": "off",
				"noAssignInExpressions": "off",
				"noArrayIndexKey": "off",
				"noExplicitAny": "off",
				"noGlobalIsNan": "off",
				"noGlobalAssign": "off"
			}
		}
	}
}
